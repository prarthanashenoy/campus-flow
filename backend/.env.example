# Application
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://campusflow:campusflow@localhost:5432/campusflow

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-tenant.auth0.com/api/v2/

# Oso Cloud — leave blank to run without Oso (falls back to DB ownership checks)
OSO_CLOUD_API_KEY=
