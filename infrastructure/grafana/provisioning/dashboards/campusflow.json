{
  "title": "CampusFlow Backend",
  "uid": "campusflow-backend",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request Rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (method, status_code)",
          "legendFormat": "{{method}} {{status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P99 Request Duration (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p99 {{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error Rate (5xx/s)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[1m]))",
          "legendFormat": "5xx errors"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Business Events",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "increase(opportunities_created_total[1h])",
          "legendFormat": "Opportunities created"
        },
        {
          "expr": "increase(registrations_created_total[1h])",
          "legendFormat": "Registrations created"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total Opportunities Created",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "opportunities_created_total",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total Registrations Created",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "registrations_created_total",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Active Node.js Heap (MB)",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes / 1024 / 1024",
          "legendFormat": "Heap used"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Node.js Event Loop Lag (ms)",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_seconds * 1000",
          "legendFormat": "Event loop lag"
        }
      ]
    }
  ]
}
