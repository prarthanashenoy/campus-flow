# Local Terraform state — use remote state (S3) in production
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Variable files often contain secrets — never commit
*.tfvars
*.tfvars.json

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
